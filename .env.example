# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (memory store)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-OR-ANON-KEY

# Gmail (dedicated agent account — see EM.1.1 / G.3)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
AGENT_GMAIL_ADDRESS=acton.finance.agent@gmail.com   # G.3 — confirm
FRED_NOTIFY_GMAIL=fred@example.com                   # G.2 — confirm

# Output (Synology Drive mount on the MacBook — G.1)
OUTPUT_ROOT=/Users/USERNAME/SynologyDrive/ActonFinanceAgent